{
  "name": "vue-electron-base",
  "version": "0.0.0",
  "private": true,
  "author": "烟雨平生",
  "description": "可复用的vue+electron整合底座，提供一键启动和打包能力",
  "main": "electrontarget/electronMain.js",
  "imports": {
    "#root/*": "./electron/*"
  },
  "scripts": {
    "dev:all": "vite",
    "build:all": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "bindings": "^1.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "element-plus": "^2.8.6",
    "express": "^4.21.1",
    "pinia": "^2.2.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "unplugin-icons": "^0.19.3",
    "unplugin-vue-components": "^0.27.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.5.0",
    "@electron-forge/maker-deb": "^7.5.0",
    "@electron-forge/maker-rpm": "^7.5.0",
    "@electron-forge/maker-squirrel": "^7.5.0",
    "@electron-forge/maker-zip": "^7.5.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.5.0",
    "@electron-forge/plugin-fuses": "^7.5.0",
    "@electron/fuses": "^1.8.0",
    "@tsconfig/node20": "^20.1.4",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.16.11",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "cypress": "^13.15.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "eslint": "^9.12.0",
    "eslint-plugin-cypress": "^4.0.0",
    "eslint-plugin-vue": "^9.29.0",
    "jsdom": "^25.0.1",
    "npm-run-all2": "^6.2.3",
    "prettier": "^3.3.3",
    "start-server-and-test": "^2.0.8",
    "typescript": "~5.5.4",
    "unplugin-auto-import": "^0.18.3",
    "vite": "^5.4.8",
    "vite-plugin-vue-devtools": "^7.4.6",
    "vitest": "^2.1.2",
    "vue-tsc": "^2.1.6"
  },
  "build": {
    "appId": "cn.yanyvpingsheng.VEB",
    "productName": "vue-electron-base",
    "files": [
      "electrontarget/**/*"
    ],
    "directories": {
      "buildResources": "./",
      "output": "out"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VEB",
      "uninstallDisplayName": "VEB",
      "runAfterFinish": true,
      "perMachine": true,
      "artifactName": "${productName}-${version}-Setup.exe",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico"
    },
    "afterPack": "./removeLocales.js"
  }
}
